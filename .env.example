# CohortDesk environment template — placeholder values only. Never commit real secrets.
COHORTDESK_SECRET_KEY=change-me
# development|production — enables security settings in production
COHORTDESK_ENVIRONMENT=development
# Comma-separated host names; empty in development (localhost only)
COHORTDESK_ALLOWED_HOSTS=
# Trust a single reverse-proxy origin header (Caddy terminates TLS)
COHORTDESK_USE_X_FORWARDED_PROTO=true
COHORTDESK_FORCE_SSL_REDIRECT=true
# Database: local development default
COHORTDESK_DB_ENGINE=sqlite
# PostgreSQL (production): set COHORTDESK_DB_ENGINE=postgres and these values
COHORTDESK_DB_HOST=
COHORTDESK_DB_PORT=
COHORTDESK_DB_NAME=
COHORTDESK_DB_USER=
COHORTDESK_DB_PASSWORD=
# Base path prefix for private media (uploads stored outside public static)
COHORTDESK_MEDIA_ROOT=media_uploads
